  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new result type invariant] inv_Duration result)
    /\ ([@stop_split] [@expl:new ensures] [%#stime'4] view_Duration result
    = secs_to_nanos (UInt64.t'int secs) + UInt32.t'int nanos)}
    (! return {result}) ]

constant const_MAX'1 : t_Duration

axiom const_MAX_spec: false -> inv_Duration const_MAX'1

let set_MAX (return) = bb0
  [ bb0 = s0
    [ s0 = [ &_2 <- let (_fst, _snd) = UInt32.sub_with_overflow const_NANOS_PER_SEC (1: UInt32.t) in { f0 = _fst;
                                                                                                       f1 = _snd } ] s1
    | s1 = {[@expl:Sub overflow] not _2.f1} s2
    | s2 = new {const_MAX} {_2.f0} (fun (_x: t_Duration) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ] ] [ & _ret: t_Duration = Any.any_l () | & _2: tup2_u32_bool = Any.any_l () ]
  [ return (_const: t_Duration) -> -{const_MAX'1 = _const}- return ]

let elim_Some (_x: t_Option_u128) (return (f0'0: UInt128.t)) = any
  [ _k (f0'0: UInt128.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

constant duration_max_nanos: int = [%#sduration] UInt64.t'int const_MAX * 1000000000 + 999999999

let duration_from_nanos (nanos: UInt128.t) (return (x: t_Duration)) =
{[@stop_split] [@expl:duration_from_nanos requires] [%#sprojection'9] UInt128.t'int nanos <= duration_max_nanos}
  any
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:duration_from_nanos ensures] ([@stop_split] [@expl:duration_from_nanos result type invariant] [%#sprojection'10] inv_Duration result)
    /\ ([@stop_split] [@expl:duration_from_nanos ensures] [%#sprojection'11] view_Duration result
    = UInt128.t'int nanos)}
    (! return {result}) ]

