meta "select_lsinst" "all"

let saturating_duration_mul [#"crates/hoimin-budget-math/src/projection.rs" 89 0 89 73] (duration: t_Duration)
  (factor: UInt64.t) (return (x: t_Duration)) =
{[@stop_split] [@expl:saturating_duration_mul 'duration' type invariant] [%#sprojection'6] inv_Duration duration}
  (! set_MAX
    (bb0
    [ bb0 = s0
      [ s0 = as_nanos [%#sprojection] {duration} (fun (_x: UInt128.t) -> [ &_9 <- _x ] s1)
      | s1 = [ &_11 <- UInt128.of_int (UInt64.t'int factor) ] s2
      | s2 = checked_mul [%#sprojection'0] {_9} {_11} (fun (_x: t_Option_u128) -> [ &_8 <- _x ] s3)
      | s3 = any [ br0 -> {_8 = None} (! bb5) | br1 (x0: UInt128.t) -> {_8 = Some x0} (! bb4) ] ]
    | bb5 = s0 [ s0 = [ &_ret <- [%#sprojection'1] const_MAX'1 ] s1 | s1 = return {_ret} ]
    | bb4 = s0
      [ s0 = elim_Some {_8} (fun (r0: UInt128.t) -> [ &nanos <- r0 ] s1)
      | s1 = bb0'0
        [ bb0'0 = s0'0 [ s0'0 = [ &_ret'0 <- [%#sprojection'2] const_MAX'1 ] s1'0 | s1'0 = _const_ret {_ret'0} ] ]
        [ & _ret'0: t_Duration = Any.any_l () ] [ _const_ret (_const: t_Duration) -> [ &_22 <- _const ] s2 ]
      | s2 = as_nanos [%#sprojection'3] {_22} (fun (_x: UInt128.t) -> [ &_17 <- _x ] s3)
      | s3 = [ &_15 <- UInt128.gt nanos _17 ] s4
      | s4 = any [ br0 -> {_15 = false} (! bb8) | br1 -> {_15} (! bb7) ] ]
    | bb7 = s0 [ s0 = [ &_ret <- [%#sprojection'4] const_MAX'1 ] s1 | s1 = return {_ret} ]
    | bb8 = s0
      [ s0 = duration_from_nanos [%#sprojection'5] {nanos} (fun (_x: t_Duration) -> [ &_ret <- _x ] s1)
      | s1 = return {_ret} ] ]
    [ & _ret: t_Duration = Any.any_l ()
    | & duration: t_Duration = duration
    | & factor: UInt64.t = factor
    | & nanos: UInt128.t = Any.any_l ()
    | & _8: t_Option_u128 = Any.any_l ()
    | & _9: UInt128.t = Any.any_l ()
    | & _11: UInt128.t = Any.any_l ()
    | & _15: bool = Any.any_l ()
    | & _17: UInt128.t = Any.any_l ()
    | & _22: t_Duration = Any.any_l () ]))
  [ return (result: t_Duration) ->
  {[@stop_split] [@expl:saturating_duration_mul ensures] ([@stop_split] [@expl:saturating_duration_mul result type invariant] [%#sprojection'7] inv_Duration result)
    /\ ([@stop_split] [@expl:saturating_duration_mul ensures] [%#sprojection'8] view_Duration result
    = MinMax.min (view_Duration duration * UInt64.t'int factor) duration_max_nanos)}
    (! return {result}) ]
