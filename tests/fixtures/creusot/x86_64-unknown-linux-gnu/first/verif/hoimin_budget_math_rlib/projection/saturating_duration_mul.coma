type t_Duration

predicate inv_Duration (_1: t_Duration)

predicate invariant_ref_Duration [@inline:trivial] (self: t_Duration) = [%#sinvariant] inv_Duration self

meta "rewrite_def" predicate invariant_ref_Duration

predicate inv_ref_Duration [@inline:trivial] (_1: t_Duration) = invariant_ref_Duration _1

meta "rewrite_def" predicate inv_ref_Duration

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

function secs_to_nanos (secs: int) : int = [%#stime'2] secs * 1000000000

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Duration (self: t_Duration) : int

axiom view_Duration_spec: forall self: t_Duration [view_Duration self]. [%#stime'1] ge_log_Int (view_Duration self) 0
    /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999

let as_nanos (self: t_Duration) (return (x: UInt128.t)) =
{[@stop_split] [@expl:as_nanos 'self' type invariant] inv_ref_Duration self}
  any
  [ return (result: UInt128.t) ->
  {[@stop_split] [@expl:as_nanos ensures] ([@stop_split] [@expl:as_nanos ensures #0] [%#stime] UInt128.t'int result
      = view_Duration self)
    /\ ([@stop_split] [@expl:as_nanos ensures #1] [%#stime'0] UInt128.t'int result
    <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999)}
    (! return {result}) ]

type t_Option_u128 = None | Some UInt128.t

constant const_MIN: UInt128.t = (0: UInt128.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX'0: UInt128.t = (340282366920938463463374607431768211455: UInt128.t)

let checked_mul (self: UInt128.t) (rhs: UInt128.t) (return (x: t_Option_u128)) = any
  [ return (result: t_Option_u128) ->
  {[@stop_split] [@expl:checked_mul ensures] ([@stop_split] [@expl:checked_mul ensures #0] [%#snum] (result = None)
      = (UInt128.t'int self * UInt128.t'int rhs < UInt128.t'int const_MIN
      \/ gt_log_Int (UInt128.t'int self * UInt128.t'int rhs) (UInt128.t'int const_MAX'0)))
    /\ ([@stop_split] [@expl:checked_mul ensures #1] [%#snum'0] forall r: UInt128.t. result = Some r
      -> UInt128.t'int r = UInt128.t'int self * UInt128.t'int rhs)}
    (! return {result}) ]

constant const_NANOS_PER_SEC: UInt32.t = [%#sprojection'12] (1000000000: UInt32.t)

type tup2_u32_bool = { f0: UInt32.t; f1: bool }

function nanos_to_secs (nanos: int) : int = [%#stime'5] ComputerDivision.div nanos 1000000000

let new (secs: UInt64.t) (nanos: UInt32.t) (return (x: t_Duration)) =
{[@stop_split] [@expl:new requires] [%#stime'3] UInt64.t'int secs + nanos_to_secs (UInt32.t'int nanos)
  <= UInt64.t'int const_MAX}
  any
