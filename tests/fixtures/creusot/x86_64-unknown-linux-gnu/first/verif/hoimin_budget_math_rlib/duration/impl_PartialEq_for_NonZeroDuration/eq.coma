use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Duration

type t_NonZeroDuration = { f0: t_Duration }

predicate inv_Duration (_1: t_Duration)

predicate invariant_ref_Duration [@inline:trivial] (self: t_Duration) = [%#sinvariant] inv_Duration self

meta "rewrite_def" predicate invariant_ref_Duration

predicate inv_ref_Duration [@inline:trivial] (_1: t_Duration) = invariant_ref_Duration _1

meta "rewrite_def" predicate inv_ref_Duration

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function secs_to_nanos (secs: int) : int = [%#stime'1] secs * 1000000000

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Duration (self: t_Duration) : int

axiom view_Duration_spec: forall self: t_Duration [view_Duration self]. [%#stime'0] ge_log_Int (view_Duration self) 0
    /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999

function deep_model_Duration [@inline:trivial] (self: t_Duration) : int = [%#stime] view_Duration self

meta "rewrite_def" function deep_model_Duration

function deep_model_ref_Duration [@inline:trivial] (self: t_Duration) : int = [%#smodel] deep_model_Duration self

meta "rewrite_def" function deep_model_ref_Duration

let eq_Duration (self: t_Duration) (other: t_Duration) (return (x: bool)) =
{[@stop_split] [@expl:eq_Duration requires] ([@stop_split] [@expl:eq 'self' type invariant] inv_ref_Duration self)
  /\ ([@stop_split] [@expl:eq 'other' type invariant] inv_ref_Duration other)}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] [%#scmp] result
    = (deep_model_ref_Duration self = deep_model_ref_Duration other)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function view_NonZeroDuration [#"crates/hoimin-budget-math/src/duration.rs" 24 4 24 24] (self: t_NonZeroDuration) : int
