let eq_NonZeroDuration [#"crates/hoimin-budget-math/src/duration.rs" 14 4 14 38] (self: t_NonZeroDuration)
  (other: t_NonZeroDuration) (return (x: bool)) =
{[@stop_split] [@expl:eq_NonZeroDuration requires] ([@stop_split] [@expl:eq 'self' type invariant] [%#sduration'0] inv_ref_NonZeroDuration self)
  /\ ([@stop_split] [@expl:eq 'other' type invariant] [%#sduration'1] inv_ref_NonZeroDuration other)}
  (! bb0
  [ bb0 = s0
    [ s0 = eq_Duration [%#sduration] {self.f0} {other.f0} (fun (_x: bool) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & self: t_NonZeroDuration = self | & other: t_NonZeroDuration = other ])
  [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] [%#sduration'2] result
    = (deep_model_ref_NonZeroDuration self = deep_model_ref_NonZeroDuration other)}
    (! return {result}) ]
