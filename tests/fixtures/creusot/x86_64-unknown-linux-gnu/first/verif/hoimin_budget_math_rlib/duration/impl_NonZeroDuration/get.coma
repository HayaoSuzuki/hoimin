let%span sduration = "crates/hoimin-budget-math/src/duration.rs" 63 15 63 19
let%span sduration'0 = "crates/hoimin-budget-math/src/duration.rs" 63 24 63 32
let%span sduration'1 = "crates/hoimin-budget-math/src/duration.rs" 62 32 62 63
let%span sduration'2 = "crates/hoimin-budget-math/src/duration.rs" 25 20 25 27
