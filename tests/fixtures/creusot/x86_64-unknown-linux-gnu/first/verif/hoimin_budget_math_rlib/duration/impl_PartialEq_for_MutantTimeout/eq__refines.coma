use creusot.int.UInt64
use int.Int

type t_Duration

type t_NonZeroDuration = { f0: t_Duration }

type t_MutantTimeout = Auto | Fixed t_NonZeroDuration

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function secs_to_nanos (secs: int) : int = [%#stime'0] secs * 1000000000

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Duration (self: t_Duration) : int

axiom view_Duration_spec: forall self: t_Duration [view_Duration self]. [%#stime] ge_log_Int (view_Duration self) 0
    /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999

function view_NonZeroDuration [#"crates/hoimin-budget-math/src/duration.rs" 24 4 24 24] (self: t_NonZeroDuration) : int
 = [%#sduration'4] view_Duration self.f0

predicate invariant_NonZeroDuration [#"crates/hoimin-budget-math/src/duration.rs" 42 4 42 30] (self: t_NonZeroDuration) =
  [%#sduration'5] gt_log_Int (view_NonZeroDuration self) 0

predicate inv_Duration (_1: t_Duration)

predicate inv_NonZeroDuration (_1: t_NonZeroDuration)

axiom inv_axiom [@rewrite]: forall _1: t_NonZeroDuration [inv_NonZeroDuration _1]. inv_NonZeroDuration _1
    = (invariant_NonZeroDuration _1 /\ inv_Duration _1.f0)

predicate inv_MutantTimeout (_1: t_MutantTimeout)

axiom inv_axiom'0 [@rewrite]: forall _1: t_MutantTimeout [inv_MutantTimeout _1]. inv_MutantTimeout _1
    = match _1 with
      | Auto -> true
      | Fixed f0'0 -> inv_NonZeroDuration f0'0
      end

predicate invariant_ref_MutantTimeout [@inline:trivial] (self: t_MutantTimeout) = [%#sinvariant] inv_MutantTimeout self

meta "rewrite_def" predicate invariant_ref_MutantTimeout

predicate inv_ref_MutantTimeout [@inline:trivial] (_1: t_MutantTimeout) = invariant_ref_MutantTimeout _1

meta "rewrite_def" predicate inv_ref_MutantTimeout

type t_MutantTimeoutDeepModel = Auto'0 | Fixed'0 int

function deep_model_NonZeroDuration [#"crates/hoimin-budget-math/src/duration.rs" 34 4 34 30] (self: t_NonZeroDuration) : int
 = [%#sduration'3] view_NonZeroDuration self

function deep_model_MutantTimeout [#"crates/hoimin-budget-math/src/duration.rs" 81 27 81 58] (self: t_MutantTimeout) : t_MutantTimeoutDeepModel
 = [%#sduration'2] match self with
    | Auto -> Auto'0
    | Fixed v0_1 -> Fixed'0 (deep_model_NonZeroDuration v0_1)
    end

function deep_model_ref_MutantTimeout [@inline:trivial] (self: t_MutantTimeout) : t_MutantTimeoutDeepModel =
  [%#smodel] deep_model_MutantTimeout self

meta "rewrite_def" function deep_model_ref_MutantTimeout

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_MutantTimeout, other: t_MutantTimeout. inv_ref_MutantTimeout self
    -> inv_ref_MutantTimeout other
    -> ([%#sduration] inv_ref_MutantTimeout self)
    /\ ([%#sduration'0] inv_ref_MutantTimeout other)
    /\ (forall result: bool. ([%#sduration'1] result
        = (deep_model_ref_MutantTimeout self = deep_model_ref_MutantTimeout other))
      -> ([%#scmp] result = (deep_model_ref_MutantTimeout self = deep_model_ref_MutantTimeout other)))
