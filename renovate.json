{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "pep621": {
    "rangeStrategy": "update-lockfile",
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "packageRules": [
    {
      "description": "Group production dependencies after 7 days",
      "matchManagers": ["cargo"],
      "matchDepTypes": ["dependencies"],
      "groupName": "production dependencies",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group Rust development dependencies after 3 days",
      "matchManagers": ["cargo"],
      "matchDepTypes": ["dev-dependencies"],
      "groupName": "development dependencies",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group Python development dependencies after 3 days",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "groupName": "development dependencies",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group GitHub Actions updates after 3 days",
      "matchManagers": ["github-actions"],
      "groupName": "development dependencies",
      "minimumReleaseAge": "3 days"
    }
  ]
}
