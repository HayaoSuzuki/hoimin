+//! Temporary measurement only; not part of the product source tree.
+use std::sync::Mutex;
+use std::time::Instant;
+static EVENTS: Mutex<Vec<(&'static str, u64)>> = Mutex::new(Vec::new());
+pub struct Probe { name: &'static str, started: Instant }
+impl Probe {
+    pub fn new(name: &'static str) -> Self { Self { name, started: Instant::now() } }
+}
+impl Drop for Probe {
+    fn drop(&mut self) {
+        let ns = self.started.elapsed().as_nanos() as u64;
+        EVENTS.lock().unwrap().push((self.name, ns));
+    }
+}
+pub fn flush() {
+    let events = EVENTS.lock().unwrap();
+    eprintln!("HOIMIN_PROBE {}", serde_json::to_string(&*events).unwrap());
+}
