+/// Encodes at most one spool record, reserving space for its final newline.
+/// Check each chunk before allocation; Vec's geometric growth is also capped.
+struct BoundedRecordWriter {
+    bytes: Vec<u8>,
+    limit: usize,
+    limit_exceeded: bool,
+}
+
+impl BoundedRecordWriter {
+    fn new(limit: usize) -> Self {
+        Self {
+            bytes: Vec::new(),
+            limit,
+            limit_exceeded: false,
+        }
+    }
+}
+
+impl Write for BoundedRecordWriter {
+    fn write(&mut self, buffer: &[u8]) -> std::io::Result<usize> {
+        let required = self.bytes.len().checked_add(buffer.len());
+        let Some(required) = required.filter(|size| *size < self.limit) else {
+            self.limit_exceeded = true;
+            return Err(std::io::Error::other("candidate spool record exceeds limit"));
+        };
+        // The extra byte prevents push(newline) from doubling a full buffer.
+        if required + 1 > self.bytes.capacity() {
+            let capacity = self
+                .bytes
+                .capacity()
+                .saturating_mul(2)
+                .max(256)
+                .max(required + 1)
+                .min(self.limit);
+            self.bytes.reserve_exact(capacity - self.bytes.len());
+        }
+        self.bytes.extend_from_slice(buffer);
+        Ok(buffer.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
