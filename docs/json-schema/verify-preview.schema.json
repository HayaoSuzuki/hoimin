{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tokyogas-tech/hoimin/main/docs/json-schema/verify-preview.schema.json",
  "title": "hoimin verify selection preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_schema_version",
    "ranking_rule_version",
    "verification_selection",
    "offset",
    "retained_candidates",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "verify_preview"
    },
    "plan_schema_version": {
      "const": 5
    },
    "ranking_rule_version": {
      "const": 4
    },
    "verification_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "policy",
        "requested",
        "selected",
        "scope",
        "plan_truncated"
      ],
      "properties": {
        "mode": {
          "enum": [
            "candidate_ids",
            "top",
            "sample"
          ]
        },
        "policy": {
          "enum": [
            "explicit_candidates",
            "strict",
            "file_round_robin_v1",
            "line_round_robin_v1",
            "splitmix64_fisher_yates_v1"
          ]
        },
        "requested": {
          "type": "integer",
          "minimum": 1
        },
        "selected": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "enum": [
            "explicit_candidates",
            "retained_candidates",
            "sampled_candidates"
          ]
        },
        "plan_truncated": {
          "type": "boolean"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population",
            "seed",
            "selected_ids"
          ],
          "properties": {
            "population": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "selected_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sample"
              }
            }
          },
          "then": {
            "required": [
              "sampling"
            ],
            "properties": {
              "policy": {
                "const": "splitmix64_fisher_yates_v1"
              },
              "scope": {
                "const": "sampled_candidates"
              },
              "plan_truncated": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "sampling"
              ]
            }
          }
        }
      ]
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retained_candidates": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rank",
          "selection_order",
          "path",
          "line",
          "column",
          "operator",
          "original",
          "replacement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "selection_order": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "original": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          }
        }
      }
    }
  }
}
