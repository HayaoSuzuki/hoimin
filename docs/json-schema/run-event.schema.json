{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tokyogas-tech/hoimin/main/docs/json-schema/run-event.schema.json",
  "title": "hoimin run JSON Lines event",
  "oneOf": [
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/baselineFinished" },
    { "$ref": "#/$defs/mutantStarted" },
    { "$ref": "#/$defs/mutantFinished" },
    { "$ref": "#/$defs/diagnostic" },
    { "$ref": "#/$defs/runFinished" }
  ],
  "$defs": {
    "janitorSummary": {
      "type": "object",
      "required": [
        "inspected_roots",
        "reclaimed_roots",
        "absent_roots",
        "preserved_roots",
        "unresolved_roots",
        "examined_entries",
        "removed_entries",
        "preserved_by_reason",
        "unresolved_by_reason",
        "scan",
        "details",
        "detail_omissions"
      ],
      "properties": {
        "inspected_roots": {
          "type": "integer",
          "minimum": 0
        },
        "reclaimed_roots": {
          "type": "integer",
          "minimum": 0
        },
        "absent_roots": {
          "type": "integer",
          "minimum": 0
        },
        "preserved_roots": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_roots": {
          "type": "integer",
          "minimum": 0
        },
        "examined_entries": {
          "type": "integer",
          "minimum": 0
        },
        "removed_entries": {
          "type": "integer",
          "minimum": 0
        },
        "preserved_by_reason": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "young",
              "active_lease",
              "retain_marker",
              "coordinator_busy",
              "mutation_barrier_active",
              "invalid_candidate",
              "candidate_inspection_failed",
              "identity_inspection_failed",
              "lease_invalid",
              "lease_lock_failed",
              "marker_invalid",
              "heartbeat_invalid",
              "age_unverifiable",
              "unsafe_staging",
              "coordinator_failed",
              "mutation_barrier_failed",
              "claim_failed",
              "claimed_lease_unavailable",
              "delete_failed",
              "cleanup_incomplete",
              "selection_failed",
              "selection_deadline",
              "selection_child_limit",
              "cursor_persistence_failed"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unresolved_by_reason": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "young",
              "active_lease",
              "retain_marker",
              "coordinator_busy",
              "mutation_barrier_active",
              "invalid_candidate",
              "candidate_inspection_failed",
              "identity_inspection_failed",
              "lease_invalid",
              "lease_lock_failed",
              "marker_invalid",
              "heartbeat_invalid",
              "age_unverifiable",
              "unsafe_staging",
              "coordinator_failed",
              "mutation_barrier_failed",
              "claim_failed",
              "claimed_lease_unavailable",
              "delete_failed",
              "cleanup_incomplete",
              "selection_failed",
              "selection_deadline",
              "selection_child_limit",
              "cursor_persistence_failed"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "scan": {
          "type": "object",
          "required": [
            "directory_scan_complete",
            "selection_limited",
            "cursor_deferred",
            "observed_matching_entries",
            "selected_roots",
            "uninspected_selected_roots",
            "selection_omitted_observed_entries",
            "stop_reason"
          ],
          "properties": {
            "directory_scan_complete": {
              "type": "boolean"
            },
            "selection_limited": {
              "type": "boolean"
            },
            "cursor_deferred": {
              "type": "boolean"
            },
            "observed_matching_entries": {
              "type": "integer",
              "minimum": 0
            },
            "selected_roots": {
              "type": "integer",
              "minimum": 0
            },
            "uninspected_selected_roots": {
              "type": "integer",
              "minimum": 0
            },
            "selection_omitted_observed_entries": {
              "type": "integer",
              "minimum": 0
            },
            "stop_reason": {
              "enum": [
                "young",
                "active_lease",
                "retain_marker",
                "coordinator_busy",
                "mutation_barrier_active",
                "invalid_candidate",
                "candidate_inspection_failed",
                "identity_inspection_failed",
                "lease_invalid",
                "lease_lock_failed",
                "marker_invalid",
                "heartbeat_invalid",
                "age_unverifiable",
                "unsafe_staging",
                "coordinator_failed",
                "mutation_barrier_failed",
                "claim_failed",
                "claimed_lease_unavailable",
                "delete_failed",
                "cleanup_incomplete",
                "selection_failed",
                "selection_deadline",
                "selection_child_limit",
                "cursor_persistence_failed",
                null
              ]
            }
          },
          "additionalProperties": false
        },
        "details": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "reason",
              "message"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "young",
                  "active_lease",
                  "retain_marker",
                  "coordinator_busy",
                  "mutation_barrier_active",
                  "invalid_candidate",
                  "candidate_inspection_failed",
                  "identity_inspection_failed",
                  "lease_invalid",
                  "lease_lock_failed",
                  "marker_invalid",
                  "heartbeat_invalid",
                  "age_unverifiable",
                  "unsafe_staging",
                  "coordinator_failed",
                  "mutation_barrier_failed",
                  "claim_failed",
                  "claimed_lease_unavailable",
                  "delete_failed",
                  "cleanup_incomplete",
                  "selection_failed",
                  "selection_deadline",
                  "selection_child_limit",
                  "cursor_persistence_failed"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "additionalProperties": false
          }
        },
        "detail_omissions": {
          "type": "object",
          "required": [
            "normal_details",
            "issue_details",
            "truncated_details",
            "suppressed_normal_details"
          ],
          "properties": {
            "normal_details": {
              "type": "integer",
              "minimum": 0
            },
            "issue_details": {
              "type": "integer",
              "minimum": 0
            },
            "truncated_details": {
              "type": "integer",
              "minimum": 0
            },
            "suppressed_normal_details": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Janitor-owned bounded observations, not a census of remaining roots. Removed entries count acknowledged deletion operations (Windows may be delete-pending), not freed bytes. Root outcomes partition inspected_roots. Detail byte cap is 4096 UTF-8 bytes; maxLength is only a codepoint bound."
    },
    "sessionMode": {
      "oneOf": [
        { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "disabled" } }, "additionalProperties": false },
        { "type": "object", "required": ["mode", "config"], "properties": { "mode": { "enum": ["fresh", "resume"] }, "config": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" } }, "additionalProperties": false } }, "additionalProperties": false }
      ]
    },
    "environmentSnapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "untracked"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "names",
            "digest"
          ],
          "properties": {
            "state": {
              "const": "captured"
            },
            "names": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
              }
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "changedSelection": {
      "type": "object",
      "required": [
        "context"
      ],
      "properties": {
        "context": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741823
        },
        "diff_base": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "schemaVersion": {
      "type": "integer",
      "const": 10
    },
    "resumeOutcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "resumed" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "fresh" },
            "reason": { "type": "string", "enum": ["no_prior_run", "matching_run_complete", "budget_decreased", "fingerprint_mismatch", "no_incomplete_run", "candidate_changed"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "resourceMode": {
      "type": "string",
      "enum": ["hard", "best_effort"]
    },
    "status": {
      "type": "string",
      "enum": [
        "killed",
        "survived",
        "timeout",
        "out_of_memory",
        "process_limit",
        "error",
        "not_run"
      ]
    },
    "output": {
      "type": "object",
      "description": "A bounded process-output spool reference. retained and observed are byte counts that expose truncation.",
      "required": ["token", "retained", "observed"],
      "properties": {
        "token": { "type": "string" },
        "retained": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "termination": {
      "oneOf": [
        {
          "type": "object",
          "required": ["Exit"],
          "properties": {
            "Exit": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "string",
          "enum": ["Timeout", "OutOfMemory", "ProcessLimit", "Cancelled"]
        }
      ]
    },
    "span": {
      "type": "object",
      "required": ["start", "length"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "path",
        "span",
        "original",
        "replacement",
        "operator",
        "line",
        "column",
        "symbol",
        "file_hash"
      ],
      "properties": {
        "id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "original": { "type": "string" },
        "replacement": { "type": "string" },
        "operator": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "symbol": { "type": ["string", "null"] },
        "file_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "killed",
        "survived",
        "timeout",
        "out_of_memory",
        "process_limit",
        "error",
        "not_run",
        "inconclusive",
        "score"
      ],
      "properties": {
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "out_of_memory": { "type": "integer", "minimum": 0 },
        "process_limit": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "verificationSelection": {
      "type": "object",
      "description": "Verification selection metadata. Additional fields are accepted; known fields must agree with the selection mode.",
      "required": [
        "mode",
        "policy",
        "requested",
        "selected",
        "scope",
        "plan_truncated"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "candidate_ids",
            "top",
            "sample"
          ]
        },
        "policy": {
          "type": "string",
          "enum": [
            "explicit_candidates",
            "strict",
            "file_round_robin_v1",
            "line_round_robin_v1",
            "splitmix64_fisher_yates_v1"
          ]
        },
        "requested": {
          "type": "integer",
          "minimum": 1
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "enum": [
            "explicit_candidates",
            "retained_candidates",
            "sampled_candidates"
          ]
        },
        "plan_truncated": {
          "type": "boolean"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population",
            "seed",
            "selected_ids"
          ],
          "properties": {
            "population": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "selected_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "sample"
              }
            }
          },
          "then": {
            "required": [
              "sampling"
            ],
            "properties": {
              "policy": {
                "const": "splitmix64_fisher_yates_v1"
              },
              "scope": {
                "const": "sampled_candidates"
              },
              "plan_truncated": {
                "const": false
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "sampling"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "candidate_ids"
              }
            }
          },
          "then": {
            "properties": {
              "policy": {
                "enum": [
                  "explicit_candidates"
                ]
              },
              "scope": {
                "const": "explicit_candidates"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "top"
              }
            }
          },
          "then": {
            "properties": {
              "policy": {
                "enum": [
                  "strict",
                  "file_round_robin_v1",
                  "line_round_robin_v1"
                ]
              },
              "scope": {
                "const": "retained_candidates"
              }
            }
          }
        }
      ]
    },
    "diskCapabilityProbe": {
      "type": "object",
      "required": ["capability", "verified", "observation"],
      "properties": {
        "capability": { "const": "project_quota" },
        "verified": { "const": true },
        "observation": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "diskEnforcement": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "portable_guard" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "root_kind", "filesystem_key"],
          "properties": {
            "kind": { "const": "capacity_only" },
            "root_kind": { "type": "string", "minLength": 1 },
            "filesystem_key": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "backend", "probe"],
          "properties": {
            "kind": { "const": "verified_aggregate" },
            "backend": { "type": "string", "enum": ["linux_project_quota"] },
            "probe": { "$ref": "#/$defs/diskCapabilityProbe" }
          },
          "additionalProperties": false
        }
      ]
    },
    "diskFilesystem": {
      "type": "object",
      "required": ["key", "start_available_bytes", "minimum_available_bytes", "end_available_bytes", "available_bytes_change"],
      "properties": {
        "key": { "type": "string" },
        "start_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "minimum_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "end_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "available_bytes_change": { "type": ["integer", "null"] }
      },
      "oneOf": [
        {
          "required": ["start_available_bytes", "end_available_bytes", "available_bytes_change"],
          "properties": {
            "start_available_bytes": { "type": "integer" },
            "end_available_bytes": { "type": "integer" },
            "available_bytes_change": { "type": "integer" }
          }
        },
        {
          "required": ["start_available_bytes", "available_bytes_change"],
          "properties": {
            "start_available_bytes": { "type": "null" },
            "available_bytes_change": { "type": "null" }
          }
        },
        {
          "required": ["start_available_bytes", "end_available_bytes", "available_bytes_change"],
          "properties": {
            "start_available_bytes": { "type": "integer" },
            "end_available_bytes": { "type": "null" },
            "available_bytes_change": { "type": "null" }
          }
        }
      ],
      "additionalProperties": false
    },
    "diskCleanup": {
      "type": "object",
      "required": ["root_id", "owner", "status", "examined_entries", "removed_entries", "details", "omitted_detail_count", "remaining_root"],
      "properties": {
        "root_id": { "type": "string" },
        "owner": { "type": "string" },
        "status": { "type": "string", "enum": ["clean", "failed", "deferred", "retained", "cleanup_after_delivery"] },
        "examined_entries": { "type": "integer", "minimum": 0 },
        "removed_entries": { "type": "integer", "minimum": 0 },
        "details": { "type": "array", "items": { "type": "string" } },
        "omitted_detail_count": { "type": "integer", "minimum": 0 },
        "remaining_root": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "diskStop": {
      "type": ["object", "null"],
      "required": ["code", "owned_bytes", "available_bytes", "message"],
      "properties": {
        "code": { "type": "string" },
        "owned_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": ["string", "null"] },
        "secondary": {
          "type": "array",
          "items": { "$ref": "#/$defs/diskSecondary" }
        }
      },
      "additionalProperties": false
    },
    "diskSecondary": {
      "oneOf": [
        {
          "type": "object",
          "required": ["Observation"],
          "properties": {
            "Observation": {
              "type": "object",
              "required": ["reason", "value"],
              "properties": {
                "reason": { "type": "string", "enum": ["workspace_size_exceeded", "filesystem_reserve_reached", "measurement_failed", "process_failed"] },
                "value": {
                  "type": "object",
                  "required": ["owned_bytes", "available_bytes", "measured_in"],
                  "properties": {
                    "owned_bytes": { "type": "integer", "minimum": 0 },
                    "available_bytes": { "type": "integer", "minimum": 0 },
                    "measured_in": {
                      "type": "object",
                      "required": ["secs", "nanos"],
                      "properties": {
                        "secs": { "type": "integer", "minimum": 0 },
                        "nanos": { "type": "integer", "minimum": 0, "maximum": 999999999 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Error"],
          "properties": {
            "Error": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "diskRunSummary": {
      "type": "object",
      "required": ["configured_max_owned_bytes", "configured_min_free_bytes", "peak_owned_bytes", "minimum_available_bytes", "filesystems", "sample_count", "maximum_measurement_ms", "enforcement", "stop", "cleanup", "removed_logical_bytes", "janitor"],
      "properties": {
        "configured_max_owned_bytes": { "type": "integer", "minimum": 1 },
        "configured_min_free_bytes": { "type": "integer", "minimum": 1 },
        "peak_owned_bytes": { "type": "integer", "minimum": 0 },
        "minimum_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "filesystems": { "type": "array", "items": { "$ref": "#/$defs/diskFilesystem" } },
        "sample_count": { "type": "integer", "minimum": 0 },
        "maximum_measurement_ms": { "type": "integer", "minimum": 0 },
        "enforcement": { "type": "array", "items": { "$ref": "#/$defs/diskEnforcement" } },
        "stop": { "$ref": "#/$defs/diskStop" },
        "cleanup": { "type": "array", "items": { "$ref": "#/$defs/diskCleanup" } },
        "removed_logical_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "janitor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/janitorSummary" }] }
      },
      "additionalProperties": false
    },
    "runStarted": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "normalized_config",
        "versions",
        "resource_control"
      ],
      "properties": {
        "kind": { "const": "run_started" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "normalized_config": {
          "type": [
            "object",
            "null"
          ],
          "description": "The project root is stored only in selection.root; the outer root field is rejected. Normalized invocation config includes an explicit validated environment snapshot; captured environment values are not included. Session intent uses mode disabled, fresh, or resume; enabled modes include config.path. Legacy session/resume pairs are rejected by normalized configuration readers.",
          "additionalProperties": true,
          "required": [
            "environment",
            "selection",
            "session"
          ],
          "properties": {
            "discovery": false,
            "limits": {
              "type": "object",
              "properties": { "analyzer_timeout": false }
            },
            "root": false,
            "resume": false,
            "session": { "$ref": "#/$defs/sessionMode" },
            "environment": {
              "$ref": "#/$defs/environmentSnapshot"
            },
            "selection": {
              "type": "object",
              "required": ["root"],
              "properties": {
                "root": { "type": "string" },
                "changed": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/changedSelection"
                    }
                  ]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "changed_context"
                    ]
                  },
                  {
                    "required": [
                      "diff_base"
                    ]
                  }
                ]
              },
              "additionalProperties": true
            }
          }
        },
        "versions": {
          "type": "object",
          "required": ["os", "hoimin"],
          "properties": {
            "os": { "type": "string" },
            "hoimin": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resource_control": {
          "type": "object",
          "required": ["mode", "mechanism"],
          "properties": {
            "mode": { "$ref": "#/$defs/resourceMode" },
            "mechanism": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resume": { "$ref": "#/$defs/resumeOutcome" },
        "verification_selection": { "$ref": "#/$defs/verificationSelection" }
      },
      "additionalProperties": false
    },
    "baselineFinished": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "termination",
        "elapsed_ms",
        "resource_mode",
        "output"
      ],
      "properties": {
        "kind": { "const": "baseline_finished" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "termination": { "$ref": "#/$defs/termination" },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "resource_mode": { "$ref": "#/$defs/resourceMode" },
        "output": { "$ref": "#/$defs/output" }
      },
      "additionalProperties": false
    },
    "mutantStarted": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "mutant_id",
        "mutant_sequence"
      ],
      "properties": {
        "kind": { "const": "mutant_started" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "mutant_id": { "type": "string" },
        "mutant_sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mutationDuration": {
      "type": "object",
      "required": [
        "secs",
        "nanos"
      ],
      "properties": {
        "secs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "nanos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        }
      },
      "additionalProperties": false
    },
    "mutationOutcome": {
      "oneOf": [
        {
          "const": "not_run"
        },
        {
          "type": "object",
          "required": [
            "reused"
          ],
          "properties": {
            "reused": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "killed",
                    "survived"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "executed"
          ],
          "properties": {
            "executed": {
              "type": "object",
              "required": [
                "termination",
                "output_state",
                "output",
                "elapsed"
              ],
              "properties": {
                "termination": {
                  "$ref": "#/$defs/termination"
                },
                "output_state": {
                  "enum": [
                    "complete",
                    "close_timed_out"
                  ]
                },
                "output": {
                  "$ref": "#/$defs/output"
                },
                "elapsed": {
                  "$ref": "#/$defs/mutationDuration"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sessionDiagnostic": {
      "type": "object",
      "required": [
        "mutant_id",
        "level",
        "code",
        "message"
      ],
      "properties": {
        "mutant_id": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mutantFinished": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "candidate",
        "resource_mode",
        "outcome",
        "status"
      ],
      "properties": {
        "kind": {
          "const": "mutant_finished"
        },
        "schema_version": {
          "$ref": "#/$defs/schemaVersion"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "resource_mode": {
          "$ref": "#/$defs/resourceMode"
        },
        "outcome": {
          "$ref": "#/$defs/mutationOutcome"
        },
        "status": {
          "$ref": "#/$defs/status",
          "description": "Derived from outcome by MutationOutcome::status(). Strict readers enforce equality and discard this projection; JSON Schema validates its shape, not semantic consistency with outcome."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sessionDiagnostic"
          }
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "level",
        "code",
        "message"
      ],
      "properties": {
        "kind": { "const": "diagnostic" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "level": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runFinished": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "counts",
        "complete",
        "exit_code",
        "disk",
        "resolved_mutant_timeout"
      ],
      "properties": {
        "kind": { "const": "run_finished" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "counts": { "$ref": "#/$defs/counts" },
        "complete": { "type": "boolean" },
        "exit_code": { "type": "integer", "enum": [0, 2, 3, 4, 130] },
        "disk": { "$ref": "#/$defs/diskRunSummary" },
        "resolved_mutant_timeout": {
          "description": "Individual mutant process cap, not the run-wide deadline or elapsed time; null if no mutant request was constructed.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/mutationDuration" }
          ]
        },
        "verification_selection": { "$ref": "#/$defs/verificationSelection" }
      },
      "additionalProperties": false
    }
  }
}
