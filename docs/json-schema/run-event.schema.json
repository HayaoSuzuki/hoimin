{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tokyogas-tech/hoimin/main/docs/json-schema/run-event.schema.json",
  "title": "hoimin run JSON Lines event",
  "oneOf": [
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/baselineFinished" },
    { "$ref": "#/$defs/mutantStarted" },
    { "$ref": "#/$defs/mutantFinished" },
    { "$ref": "#/$defs/diagnostic" },
    { "$ref": "#/$defs/runFinished" }
  ],
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "const": 4
    },
    "resumeOutcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "resumed" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "fresh" },
            "reason": { "type": "string", "enum": ["no_prior_run", "matching_run_complete", "budget_decreased", "fingerprint_mismatch", "no_incomplete_run", "candidate_changed", "no_compatible_run"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "resourceMode": {
      "type": "string",
      "enum": ["hard", "best_effort"]
    },
    "status": {
      "type": "string",
      "enum": [
        "killed",
        "survived",
        "timeout",
        "out_of_memory",
        "process_limit",
        "error",
        "not_run"
      ]
    },
    "output": {
      "type": "object",
      "description": "A bounded process-output spool reference. retained and observed are byte counts that expose truncation.",
      "required": ["token", "retained", "observed"],
      "properties": {
        "token": { "type": "string" },
        "retained": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "termination": {
      "oneOf": [
        {
          "type": "object",
          "required": ["Exit"],
          "properties": {
            "Exit": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "string",
          "enum": ["Timeout", "OutOfMemory", "ProcessLimit", "Cancelled"]
        }
      ]
    },
    "span": {
      "type": "object",
      "required": ["start", "length"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "path",
        "span",
        "original",
        "replacement",
        "operator",
        "line",
        "column",
        "symbol",
        "file_hash"
      ],
      "properties": {
        "id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "original": { "type": "string" },
        "replacement": { "type": "string" },
        "operator": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "symbol": { "type": ["string", "null"] },
        "file_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "killed",
        "survived",
        "timeout",
        "out_of_memory",
        "process_limit",
        "error",
        "not_run",
        "inconclusive",
        "score"
      ],
      "properties": {
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "out_of_memory": { "type": "integer", "minimum": 0 },
        "process_limit": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "verificationSelection": {
      "type": "object",
      "description": "Verification selection metadata. New fields may be added in schema version 2.",
      "required": [
        "mode",
        "policy",
        "requested",
        "selected",
        "scope",
        "plan_truncated"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["candidate_ids", "top"] },
        "policy": {
          "type": "string",
          "enum": ["explicit_candidates", "strict", "file_round_robin_v1", "line_round_robin_v1"]
        },
        "requested": { "type": "integer", "minimum": 1 },
        "selected": { "type": "integer", "minimum": 0 },
        "scope": {
          "type": "string",
          "enum": ["explicit_candidates", "retained_candidates"]
        },
        "plan_truncated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "diskCapabilityProbe": {
      "type": "object",
      "required": ["capability", "verified", "observation"],
      "properties": {
        "capability": { "const": "project_quota" },
        "verified": { "const": true },
        "observation": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "diskEnforcement": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "portable_guard" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "root_kind", "filesystem_key"],
          "properties": {
            "kind": { "const": "capacity_only" },
            "root_kind": { "type": "string", "minLength": 1 },
            "filesystem_key": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "backend", "probe"],
          "properties": {
            "kind": { "const": "verified_aggregate" },
            "backend": { "type": "string", "enum": ["linux_project_quota"] },
            "probe": { "$ref": "#/$defs/diskCapabilityProbe" }
          },
          "additionalProperties": false
        }
      ]
    },
    "diskFilesystem": {
      "type": "object",
      "required": ["key", "start_available_bytes", "minimum_available_bytes", "end_available_bytes", "available_bytes_change"],
      "properties": {
        "key": { "type": "string" },
        "start_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "minimum_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "end_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "available_bytes_change": { "type": ["integer", "null"] }
      },
      "oneOf": [
        {
          "required": ["start_available_bytes", "end_available_bytes", "available_bytes_change"],
          "properties": {
            "start_available_bytes": { "type": "integer" },
            "end_available_bytes": { "type": "integer" },
            "available_bytes_change": { "type": "integer" }
          }
        },
        {
          "required": ["start_available_bytes", "available_bytes_change"],
          "properties": {
            "start_available_bytes": { "type": "null" },
            "available_bytes_change": { "type": "null" }
          }
        },
        {
          "required": ["start_available_bytes", "end_available_bytes", "available_bytes_change"],
          "properties": {
            "start_available_bytes": { "type": "integer" },
            "end_available_bytes": { "type": "null" },
            "available_bytes_change": { "type": "null" }
          }
        }
      ],
      "additionalProperties": false
    },
    "diskCleanup": {
      "type": "object",
      "required": ["root_id", "owner", "status", "examined_entries", "removed_entries", "details", "omitted_detail_count", "remaining_root"],
      "properties": {
        "root_id": { "type": "string" },
        "owner": { "type": "string" },
        "status": { "type": "string", "enum": ["clean", "failed", "deferred", "retained", "cleanup_after_delivery"] },
        "examined_entries": { "type": "integer", "minimum": 0 },
        "removed_entries": { "type": "integer", "minimum": 0 },
        "details": { "type": "array", "items": { "type": "string" } },
        "omitted_detail_count": { "type": "integer", "minimum": 0 },
        "remaining_root": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "diskStop": {
      "type": ["object", "null"],
      "required": ["code", "owned_bytes", "available_bytes", "message"],
      "properties": {
        "code": { "type": "string" },
        "owned_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": ["string", "null"] },
        "secondary": {
          "type": "array",
          "items": { "$ref": "#/$defs/diskSecondary" }
        }
      },
      "additionalProperties": false
    },
    "diskSecondary": {
      "oneOf": [
        {
          "type": "object",
          "required": ["Observation"],
          "properties": {
            "Observation": {
              "type": "object",
              "required": ["reason", "value"],
              "properties": {
                "reason": { "type": "string", "enum": ["workspace_size_exceeded", "filesystem_reserve_reached", "measurement_failed", "process_failed"] },
                "value": {
                  "type": "object",
                  "required": ["owned_bytes", "available_bytes", "measured_in"],
                  "properties": {
                    "owned_bytes": { "type": "integer", "minimum": 0 },
                    "available_bytes": { "type": "integer", "minimum": 0 },
                    "measured_in": {
                      "type": "object",
                      "required": ["secs", "nanos"],
                      "properties": {
                        "secs": { "type": "integer", "minimum": 0 },
                        "nanos": { "type": "integer", "minimum": 0, "maximum": 999999999 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["Error"],
          "properties": {
            "Error": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "diskRunSummary": {
      "type": "object",
      "required": ["configured_max_owned_bytes", "configured_min_free_bytes", "peak_owned_bytes", "minimum_available_bytes", "filesystems", "sample_count", "maximum_measurement_ms", "enforcement", "stop", "cleanup", "removed_logical_bytes", "stale_roots_reclaimed"],
      "properties": {
        "configured_max_owned_bytes": { "type": "integer", "minimum": 1 },
        "configured_min_free_bytes": { "type": "integer", "minimum": 1 },
        "peak_owned_bytes": { "type": "integer", "minimum": 0 },
        "minimum_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "filesystems": { "type": "array", "items": { "$ref": "#/$defs/diskFilesystem" } },
        "sample_count": { "type": "integer", "minimum": 0 },
        "maximum_measurement_ms": { "type": "integer", "minimum": 0 },
        "enforcement": { "type": "array", "items": { "$ref": "#/$defs/diskEnforcement" } },
        "stop": { "$ref": "#/$defs/diskStop" },
        "cleanup": { "type": "array", "items": { "$ref": "#/$defs/diskCleanup" } },
        "removed_logical_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "stale_roots_reclaimed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "runStarted": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "normalized_config",
        "versions",
        "resource_control"
      ],
      "properties": {
        "kind": { "const": "run_started" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "normalized_config": {
          "type": ["object", "null"],
          "description": "Normalized invocation config, including ordered import_roots and optional fingerprint_env names plus fingerprint_env_hash when present; captured environment values are not included. New config fields may be added without changing the run-event schema version.",
          "additionalProperties": true
        },
        "versions": {
          "type": "object",
          "required": ["os", "hoimin"],
          "properties": {
            "os": { "type": "string" },
            "hoimin": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resource_control": {
          "type": "object",
          "required": ["mode", "mechanism"],
          "properties": {
            "mode": { "$ref": "#/$defs/resourceMode" },
            "mechanism": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resume": { "$ref": "#/$defs/resumeOutcome" },
        "verification_selection": { "$ref": "#/$defs/verificationSelection" }
      },
      "additionalProperties": false
    },
    "baselineFinished": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "termination",
        "elapsed_ms",
        "resource_mode",
        "output"
      ],
      "properties": {
        "kind": { "const": "baseline_finished" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "termination": { "$ref": "#/$defs/termination" },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "resource_mode": { "$ref": "#/$defs/resourceMode" },
        "output": { "$ref": "#/$defs/output" }
      },
      "additionalProperties": false
    },
    "mutantStarted": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "mutant_id",
        "mutant_sequence"
      ],
      "properties": {
        "kind": { "const": "mutant_started" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "mutant_id": { "type": "string" },
        "mutant_sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "mutantFinished": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "candidate",
        "status",
        "termination",
        "elapsed_ms",
        "resource_mode",
        "output"
      ],
      "properties": {
        "kind": { "const": "mutant_finished" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "status": { "$ref": "#/$defs/status" },
        "termination": {
          "oneOf": [
            { "$ref": "#/$defs/termination" },
            { "type": "null" }
          ]
        },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "resource_mode": { "$ref": "#/$defs/resourceMode" },
        "output": {
          "oneOf": [
            { "$ref": "#/$defs/output" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "level",
        "code",
        "message"
      ],
      "properties": {
        "kind": { "const": "diagnostic" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "level": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runFinished": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "sequence",
        "run_id",
        "counts",
        "complete",
        "exit_code",
        "disk"
      ],
      "properties": {
        "kind": { "const": "run_finished" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sequence": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string" },
        "counts": { "$ref": "#/$defs/counts" },
        "complete": { "type": "boolean" },
        "exit_code": { "type": "integer", "enum": [0, 1, 2, 3, 4, 130] },
        "disk": { "$ref": "#/$defs/diskRunSummary" },
        "verification_selection": { "$ref": "#/$defs/verificationSelection" }
      },
      "additionalProperties": false
    }
  }
}
