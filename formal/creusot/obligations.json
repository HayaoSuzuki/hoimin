      "id": "duration_max_nanos",
      "source": "crates/hoimin-budget-math/src/duration.rs",
      "definition": "#[cfg(creusot)] #[logic(open(crate))] pub(crate) fn duration_max_nanos() -> Int { pearlite! { u64::MAX@ * 1_000_000_000 + 999_999_999 } }"
    },
    {
      "id": "auto_timeout_nanos",
      "source": "crates/hoimin-budget-math/src/duration.rs",
      "definition": "#[cfg(creusot)] #[logic(open(crate))] pub(crate) fn auto_timeout_nanos(baseline: Int) -> Int { pearlite! { (2 * baseline + 1_000_000_000).min(duration_max_nanos()).max(5_000_000_000) } }"
    },
